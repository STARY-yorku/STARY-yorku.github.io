# Copy to .env.local (local dev) or set in Vercel / GitHub Actions.
# Every value is optional. Values set here override content/site.ts.

# Public URL of the deployed site (used for SEO, sitemap and Open Graph).
NEXT_PUBLIC_SITE_URL=https://stary-yorku.github.io

# Google Forms (or other) membership registration link.
NEXT_PUBLIC_MEMBERSHIP_FORM_URL=

# Form backend endpoint for the contact form (e.g. https://formspree.io/f/xxxxxxx).
NEXT_PUBLIC_CONTACT_FORM_ENDPOINT=

# Link to the sponsorship package PDF (Google Drive, Dropbox, or /files/... in public/).
NEXT_PUBLIC_SPONSORSHIP_PACKAGE_URL=
